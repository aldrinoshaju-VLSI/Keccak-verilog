`timescale 1ns / 1ps

module sampleinball_top_new_tb;

    // Parameters
    localparam N            = 256;
    localparam TAU          = 60;
    localparam DATA_WIDTH   = 24;
    localparam Q            = 8380417;
    localparam CLK_PERIOD   = 10;

    reg clk;
    reg rst;

    // Keccak message interface
    reg  [63:0] in;
    reg         in_ready;
    reg         is_last;
    reg  [2:0]  byte_num;

    wire done;
    wire [5:0] i;
    wire [DATA_WIDTH*TAU-1:0] ram_b_mem_out_flat;

    integer k;

    // DUT
    sampleinball_top #(
        .N(N),
        .TAU(TAU),
        .DATA_WIDTH(DATA_WIDTH)
    ) DUT (
        .clk(clk),
        .rst(rst),
        .start(1'b0), // unused
        .in(in),
        .in_ready(in_ready),
        .is_last(is_last),
        .byte_num(byte_num),
        .done(done),
        .i(i),
        .ram_b_mem_out_flat(ram_b_mem_out_flat)
    );

    // Clock
    always #(CLK_PERIOD/2) clk = ~clk;

    // Reset
    task apply_reset;
    begin
        rst = 1;
        in = 0;
        in_ready = 0;
        is_last = 0;
        byte_num = 0;
        #(5*CLK_PERIOD);
        rst = 0;
    end
    endtask

    // Feed a single-byte message into Keccak ("a")
    task feed_message;
    begin
        @(posedge clk);
        in = 64'h0000000000000061; // ASCII 'a'
        in_ready = 1;
        is_last  = 1;
        byte_num = 3'd1;          // 1 byte valid
        @(posedge clk);
        in_ready = 0;
        is_last  = 0;
        byte_num = 0;
        in = 0;
    end
    endtask

    // Main sequence
    initial begin
        clk = 0;
        $display("=== SampleInBall + Keccak Integrated TB ===");
        $dumpfile("sampleinball_keccak_tb.vcd");
        $dumpvars(0, sampleinball_top_tb);

        apply_reset();
        feed_message();

        // Wait for SampleInBall completion
        wait(done);
        #20;

        $display("\n--- SampleInBall Output (TAU = %0d) ---", TAU);

        for (k = 0; k < TAU; k = k + 1) begin
            automatic integer coeff;
            coeff = ram_b_mem_out_flat[DATA_WIDTH*(k+1)-1 -: DATA_WIDTH];

            if (coeff == 1)
                $display("Coeff[%0d] = +1", k);
            else if (coeff == Q-1)
                $display("Coeff[%0d] = -1", k);
            else if (coeff == 0)
                $display("Coeff[%0d] =  0", k);
            else
                $display("Coeff[%0d] = %0d", k, coeff);
        end

        $display("=== Test completed successfully ===");
        #20 $finish;
    end

    // Timeout safety
    initial begin
        #5_000_000;
        $display("ERROR: Simulation timeout!");
        $finish;
    end

endmodule
